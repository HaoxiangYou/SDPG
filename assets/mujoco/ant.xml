<mujoco model="ant">
  <!-- MJX variant of assets/ant.xml (the brax ant): adds the ground plane and a light (the
       genesis backend adds them programmatically), MJX-friendly solver options mirroring
       assets/mujoco/{hopper,walker,humanoid}.xml, the batch-render camera, and actuators in
       the genesis backend's motor order with its motor strength as gear. The patched MJX
       solver always runs a fixed number of iterations (see externals/README.md, mujoco
       Patch 01), so keep iterations/ls_iterations small. timestep is overridden by task
       sim_options. The brax <custom> block and the textures are dropped (unused here). -->
  <compiler angle="degree" inertiafromgeom="true"/>

  <option timestep="0.005" integrator="Euler" solver="Newton" iterations="4" ls_iterations="8"/>

  <default>
    <joint armature="1" damping="1" limited="true"/>
    <!-- Body geoms collide with nothing (contype/conaffinity 0): only the feet (contype=1)
         touch the floor, as in brax, so each env carries just 4 contact slots. Orange
         matches the genesis surface color. -->
    <geom contype="0" conaffinity="0" condim="3" density="5.0" friction="1.5 0.5 0.5" rgba="1.0 0.5 0.0 1"/>
    <!-- gear = genesis _motor_strength (200 Nm per unit action). -->
    <motor ctrlrange="-1 1" ctrllimited="true" gear="200"/>
  </default>

  <worldbody>
    <!-- World light matching the genesis sensor camera light (pos [0,0,2], dir -z,
         directional, no shadows). -->
    <light pos="0 0 2" dir="0 0 -1" directional="true" cutoff="100" exponent="1" diffuse="1 1 1" specular="0.1 0.1 0.1" castshadow="false"/>
    <!-- Finite render size: madrona scales the plane render mesh by (x, y), so the
         mujoco infinite-plane convention ("0 0 1") would be invisible (see
         assets/mujoco/hopper.xml). Collision stays infinite regardless of size. -->
    <geom name="floor" type="plane" contype="1" conaffinity="1" condim="3" size="50 50 1" pos="0 0 0" rgba="0.5 0.5 0.5 1"/>
    <!-- torso z matches the genesis spawn height (default_base_pos [0, 0, 0.75]). -->
    <body name="torso" pos="0 0 0.75">
      <!-- Batch-render camera (must be camera 0; MadronaBatchRenderer enables camera
           index 0 only): tracks the torso position with fixed world orientation
           (mode="track"), matching the genesis camera mount (offset [0.5, -2, 1] from
           the torso, looking at the torso, fov 60). xyaxes = (right, up) of a camera at
           that offset looking at the origin with world +z up. -->
      <camera name="track_cam" mode="track" pos="0.5 -2 1" xyaxes="2 0.5 0 -0.5 2 4.25" fovy="60"/>
      <geom name="torso_geom" pos="0 0 0" size="0.25" type="sphere"/>
      <joint armature="0" damping="0" limited="false" margin="0.01" name="root" pos="0 0 0" type="free"/>
      <body name="front_left_leg" pos="0 0 0">
        <geom fromto="0.0 0.0 0.0 0.2 0.2 0.0" name="aux_1_geom" size="0.08" type="capsule"/>
        <body name="aux_1" pos="0.2 0.2 0">
          <joint axis="0 0 1" name="hip_1" pos="0.0 0.0 0.0" range="-30 30" type="hinge"/>
          <geom fromto="0.0 0.0 0.0 0.2 0.2 0.0" name="left_leg_geom" size="0.08" type="capsule"/>
          <body pos="0.2 0.2 0">
            <joint axis="-1 1 0" name="ankle_1" pos="0.0 0.0 0.0" range="30 70" type="hinge"/>
            <geom fromto="0.0 0.0 0.0 0.4 0.4 0.0" name="left_ankle_geom" size="0.08" type="capsule"/>
            <geom name="left_foot_geom" contype="1" pos="0.4 0.4 0" size="0.08" type="sphere" mass="0"/>
          </body>
        </body>
      </body>
      <body name="front_right_leg" pos="0 0 0">
        <geom fromto="0.0 0.0 0.0 -0.2 0.2 0.0" name="aux_2_geom" size="0.08" type="capsule"/>
        <body name="aux_2" pos="-0.2 0.2 0">
          <joint axis="0 0 1" name="hip_2" pos="0.0 0.0 0.0" range="-30 30" type="hinge"/>
          <geom fromto="0.0 0.0 0.0 -0.2 0.2 0.0" name="right_leg_geom" size="0.08" type="capsule"/>
          <body pos="-0.2 0.2 0">
            <joint axis="1 1 0" name="ankle_2" pos="0.0 0.0 0.0" range="-70 -30" type="hinge"/>
            <geom fromto="0.0 0.0 0.0 -0.4 0.4 0.0" name="right_ankle_geom" size="0.08" type="capsule"/>
            <geom name="right_foot_geom" contype="1" pos="-0.4 0.4 0" size="0.08" type="sphere" mass="0"/>
          </body>
        </body>
      </body>
      <body name="back_leg" pos="0 0 0">
        <geom fromto="0.0 0.0 0.0 -0.2 -0.2 0.0" name="aux_3_geom" size="0.08" type="capsule"/>
        <body name="aux_3" pos="-0.2 -0.2 0">
          <joint axis="0 0 1" name="hip_3" pos="0.0 0.0 0.0" range="-30 30" type="hinge"/>
          <geom fromto="0.0 0.0 0.0 -0.2 -0.2 0.0" name="back_leg_geom" size="0.08" type="capsule"/>
          <body pos="-0.2 -0.2 0">
            <joint axis="-1 1 0" name="ankle_3" pos="0.0 0.0 0.0" range="-70 -30" type="hinge"/>
            <geom fromto="0.0 0.0 0.0 -0.4 -0.4 0.0" name="third_ankle_geom" size="0.08" type="capsule"/>
            <geom name="third_foot_geom" contype="1" pos="-0.4 -0.4 0" size="0.08" type="sphere" mass="0"/>
          </body>
        </body>
      </body>
      <body name="right_back_leg" pos="0 0 0">
        <geom fromto="0.0 0.0 0.0 0.2 -0.2 0.0" name="aux_4_geom" size="0.08" type="capsule"/>
        <body name="aux_4" pos="0.2 -0.2 0">
          <joint axis="0 0 1" name="hip_4" pos="0.0 0.0 0.0" range="-30 30" type="hinge"/>
          <geom fromto="0.0 0.0 0.0 0.2 -0.2 0.0" name="rightback_leg_geom" size="0.08" type="capsule"/>
          <body pos="0.2 -0.2 0">
            <joint axis="1 1 0" name="ankle_4" pos="0.0 0.0 0.0" range="30 70" type="hinge"/>
            <geom fromto="0.0 0.0 0.0 0.4 -0.4 0.0" name="fourth_ankle_geom" size="0.08" type="capsule"/>
            <geom name="fourth_foot_geom" contype="1" pos="0.4 -0.4 0" size="0.08" type="sphere" mass="0"/>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <!-- Order matches the genesis backend's _motor_joint_names (hip_i, ankle_i for
         i = 1..4), NOT the brax actuator order; the env's action and motor-state
         ordering follows this actuator order. -->
    <motor name="hip_1"   joint="hip_1"/>
    <motor name="ankle_1" joint="ankle_1"/>
    <motor name="hip_2"   joint="hip_2"/>
    <motor name="ankle_2" joint="ankle_2"/>
    <motor name="hip_3"   joint="hip_3"/>
    <motor name="ankle_3" joint="ankle_3"/>
    <motor name="hip_4"   joint="hip_4"/>
    <motor name="ankle_4" joint="ankle_4"/>
  </actuator>
</mujoco>
